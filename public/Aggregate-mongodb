q11.



 db.products.aggregate([
...   {
...     $addFields: {
...       avgRating: { $avg: "$ratings.score" }
...     }
...   },
...   {
...     $sort: { category: 1, avgRating: -1 }
...   },
...   {
...     $group: {
...       _id: "$category",
...       topProduct: { $first: "$$ROOT" }
...     }
...   },
...   {
...     $project: {
...       _id: 0,
...       category: "$_id",
...       name: "$topProduct.name",
...       avgRating: "$topProduct.avgRating"
...     }
...   }
... ])
{ "category" : "Furniture", "name" : "Dining Table Set", "avgRating" : 4.5 }
{ "category" : "Clothing", "name" : "Running Shoes", "avgRating" : 4.5 }
{ "category" : "Home Appliances", "name" : "Refrigerator XL", "avgRating" : 5 }
{ "category" : "Electronics", "name" : "Laptop Pro", "avgRating" : 4.5 }
